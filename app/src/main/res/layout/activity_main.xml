<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_top_bar"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_line1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.02"/>

                <TextView
                    android:id="@+id/titleLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_line2"
                    android:textSize="9sp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/positionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_pill_outline"
                android:text="John 3"
                android:textSize="12sp"
                android:fontFamily="serif"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/ttsPlayBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="&#9654;"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/translationChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="KJV"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:id="@+id/noteBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_note"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- FRAGMENT CONTAINER -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- BOTTOM NAV -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconSize="21dp"
            android:background="@drawable/bg_bottom_nav"
            app:elevation="4dp"/>

    </LinearLayout>

    <!-- SPLASH OVERLAY - hidden once Bible data finishes loading -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F0A1A"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FountainPDL's"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#7B2FBE"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="HOLY BIBLE"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textColor="#C0392B"
                android:fontFamily="serif"/>

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="28dp"
                android:indeterminateTint="#7B2FBE"/>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
