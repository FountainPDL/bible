<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chapterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="22dp"
            android:paddingBottom="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/testamentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW TESTAMENT"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/bookLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="John"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/chapterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CHAPTER 3"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:fontFamily="serif"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnPrevChapter"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="&#8249; Prev"/>

                <TextView
                    android:id="@+id/btnBookmarkChapter"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Bookmark"/>

                <TextView
                    android:id="@+id/btnReadAloud"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Read Aloud"/>

                <TextView
                    android:id="@+id/btnNextChapter"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next &#8250;"/>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/verseRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="140dp"
            android:scrollbars="vertical"/>

        <FrameLayout
            android:id="@+id/focusContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:minHeight="400dp">

                    <TextView
                        android:id="@+id/focusRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John 3:16"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="serif"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:id="@+id/focusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="20sp"
                        android:gravity="center"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:lineSpacingMultiplier="1.3"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/focusPrev"
                            style="@style/PillButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="&#8249; Prev"/>

                        <TextView
                            android:id="@+id/focusCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 / 36"
                            android:textSize="11sp"
                            android:fontFamily="serif"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:id="@+id/focusNext"
                            style="@style/PillButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next &#8250;"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_action_bar"
        android:padding="10dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 verse — John 3:16"
            android:textSize="11sp"
            android:gravity="center"
            android:fontFamily="serif"
            android:paddingBottom="6dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/actionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:chipSpacingHorizontal="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHighlight"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Highlight"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnderline"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Underline"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBookmark"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookmark"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRead"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWord"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNote"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCopy"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:textSize="11sp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipClear"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textSize="11sp"/>
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ttsStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/bg_top_bar"
        android:visibility="gone"
        android:elevation="4dp">

        <TextView
            android:id="@+id/ttsStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reading verse 1..."
            android:textSize="12sp"
            android:fontFamily="serif"/>

        <TextView
            android:id="@+id/ttsStopBtn"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"/>
    </LinearLayout>

</FrameLayout>
