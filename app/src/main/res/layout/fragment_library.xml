<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/libraryListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView android:id="@+id/tabHistory" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="History"/>
                <TextView android:id="@+id/tabBookmarks" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="Bookmarks"/>
                <TextView android:id="@+id/tabHighlights" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="Highlights"/>
                <TextView android:id="@+id/tabNotes" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="Notes"/>
                <TextView android:id="@+id/tabSermons" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="Sermons"/>
                <TextView android:id="@+id/tabMarathon" style="@style/PillButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="6dp" android:text="Plans"/>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/addButtonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnAddItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_gradient"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="+ New"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="serif"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/libraryEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textSize="13sp"
            android:fontFamily="serif"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Sermon detail overlay -->
    <LinearLayout
        android:id="@+id/sermonDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/sermonDetailBack"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8249; Back"/>

            <TextView
                android:id="@+id/sermonDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Sermon Title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/sermonDetailEdit"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/sermonDetailBlocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
