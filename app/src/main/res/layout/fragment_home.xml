<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Continue reading card -->
        <LinearLayout
            android:id="@+id/continueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTINUE READING"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/continuePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="John 3"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/continueBtn"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Continue Reading →"/>
        </LinearLayout>

        <!-- Verse of the day -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERSE OF THE DAY"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/votdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="16sp"
                android:fontStyle="italic"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.4"/>

            <TextView
                android:id="@+id/votdRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="John 3:16"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- Navigate to a passage -->
        <TextView
            android:id="@+id/navigateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/bg_button_gradient"
            android:text="Navigate to a Passage"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="serif"
            android:layout_marginBottom="16dp"/>

        <!-- Quick links grid -->
        <TextView
            style="@style/SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACCESS"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/quickBookmarks"
                style="@style/PillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Bookmarks"/>

            <TextView
                android:id="@+id/quickNotes"
                style="@style/PillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Notes"/>

            <TextView
                android:id="@+id/quickSermons"
                style="@style/PillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="Sermons"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/quickMarathon"
                style="@style/PillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="Reading Plan"/>

            <TextView
                android:id="@+id/quickSearch"
                style="@style/PillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="Search"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
